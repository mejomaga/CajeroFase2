<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>

    <!-- Datos de conexión al servidor central. El cliente no tiene ningún
         otro lugar donde buscar usuarios, saldos ni transacciones: todo
         pasa por este servidor. -->
	<appSettings>
		<add key="ServidorIP" value="127.0.0.1" />
		<add key="ServidorPuerto" value="5000" />
		<add key="ServidorTimeoutMs" value="5000" />
	</appSettings>
</configuration>
